# Conexão com o Postgres (deve casar com as credenciais do docker-compose / .env da raiz)
DATABASE_URL="postgresql://praticas_app:CHANGE_ME_strong_password@localhost:5432/praticas_inovadoras?schema=public"

# Segredo do JWT — OBRIGATÓRIO. Gere um valor forte e único, ex.: openssl rand -base64 48
# O servidor NÃO inicia sem esta variável (não há valor padrão).
JWT_SECRET="CHANGE_ME_openssl_rand_base64_48"

# Validade do token de acesso (ex.: 8h, 1d). Padrão: 8h.
JWT_EXPIRES_IN="8h"

# Origens permitidas para CORS, separadas por vírgula (sem curinga em produção).
CORS_ORIGINS="http://localhost:3000"

# Credenciais do MinIO (devem casar com o docker-compose / .env da raiz)
MINIO_ROOT_USER="CHANGE_ME_minio_user"
MINIO_ROOT_PASSWORD="CHANGE_ME_strong_password"

# URL do Webhook do Power Automate (envio do OTP por e-mail institucional).
# SEGREDO: nunca comitar o valor real. Peça a URL com a assinatura (?sig=...) a quem administra o fluxo.
POWER_AUTOMATE_WEBHOOK_URL=""
