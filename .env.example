# Database (PostgreSQL) — use valores fortes e únicos (ex.: openssl rand -hex 24)
POSTGRES_USER=praticas_app
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password
POSTGRES_DB=praticas_inovadoras

# Storage (MinIO) — não use admin/admin123 em nenhum ambiente
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_strong_random_password
